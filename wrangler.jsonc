{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-realtime-notes",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-realtime-notes",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cloudflare-realtime-notes",
      "preview_bucket_name": "cloudflare-realtime-notes-preview",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DOCUMENT", "class_name": "Document" },
      { "name": "WORKSPACE_EVENTS", "class_name": "WorkspaceEvents" },
    ],
  },
  "workflows": [
    {
      "name": "cloudflare-realtime-notes-jobs-local",
      "binding": "NOTES_WORKFLOW",
      "class_name": "NotesJobWorkflow",
    },
  ],
  "queues": {
    "producers": [{ "binding": "DELIVERY_QUEUE", "queue": "cloudflare-realtime-notes-delivery-local" }],
    "consumers": [
      {
        "queue": "cloudflare-realtime-notes-delivery-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "cloudflare-realtime-notes-delivery-dlq-local",
      },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Document"] },
    { "tag": "v2", "new_sqlite_classes": ["WorkspaceEvents"] },
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:5173",
  },
  "env": {
    "production": {
      "name": "cloudflare-realtime-notes",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudflare-realtime-notes",
          "database_id": "a1e3ebcb-6fb4-4cdb-8ccc-ef5821fb6fbc",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "cloudflare-realtime-notes",
          "preview_bucket_name": "cloudflare-realtime-notes-preview",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "DOCUMENT", "class_name": "Document" },
          { "name": "WORKSPACE_EVENTS", "class_name": "WorkspaceEvents" },
        ],
      },
      "workflows": [
        {
          "name": "cloudflare-realtime-notes-jobs",
          "binding": "NOTES_WORKFLOW",
          "class_name": "NotesJobWorkflow",
        },
      ],
      "queues": {
        "producers": [{ "binding": "DELIVERY_QUEUE", "queue": "cloudflare-realtime-notes-delivery" }],
        "consumers": [
          {
            "queue": "cloudflare-realtime-notes-delivery",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "cloudflare-realtime-notes-delivery-dlq",
          },
        ],
      },
      "vars": {
        "BETTER_AUTH_URL": "https://cloudflare-realtime-notes.harold-martin.workers.dev",
      },
    },
    "notes-checks-e2e": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudflare-realtime-notes-e2e",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "cloudflare-realtime-notes-e2e",
          "preview_bucket_name": "cloudflare-realtime-notes-e2e",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "DOCUMENT", "class_name": "Document" },
          { "name": "WORKSPACE_EVENTS", "class_name": "WorkspaceEvents" },
        ],
      },
      "workflows": [
        {
          "name": "cloudflare-realtime-notes-jobs-e2e",
          "binding": "NOTES_WORKFLOW",
          "class_name": "NotesJobWorkflow",
        },
      ],
      "queues": {
        "producers": [{ "binding": "DELIVERY_QUEUE", "queue": "cloudflare-realtime-notes-delivery-e2e" }],
        "consumers": [
          {
            "queue": "cloudflare-realtime-notes-delivery-e2e",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "cloudflare-realtime-notes-delivery-dlq-e2e",
          },
        ],
      },
      "vars": {
        "BETTER_AUTH_URL": "http://127.0.0.1:4173",
        "WORKFLOW_INLINE": "true",
      },
    },
  },
}
