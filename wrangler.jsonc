{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-realtime-notes",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "analytics_engine_datasets": [
    { "binding": "OBSERVABILITY", "dataset": "cloudflare_realtime_notes_local" },
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*", "/v1/*", "/share/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-realtime-notes",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cloudflare-realtime-notes",
      "preview_bucket_name": "cloudflare-realtime-notes-preview",
    },
  ],
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [
      { "name": "DOCUMENT", "class_name": "Document" },
      { "name": "WORKSPACE_EVENTS", "class_name": "WorkspaceEvents" },
    ],
  },
  "workflows": [
    {
      "name": "cloudflare-realtime-notes-jobs-local",
      "binding": "NOTES_WORKFLOW",
      "class_name": "NotesJobWorkflow",
    },
  ],
  "queues": {
    "producers": [{ "binding": "DELIVERY_QUEUE", "queue": "cloudflare-realtime-notes-delivery-local" }],
    "consumers": [
      {
        "queue": "cloudflare-realtime-notes-delivery-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "cloudflare-realtime-notes-delivery-dlq-local",
      },
    ],
  },
  "ratelimits": [
    { "name": "API_SOURCE_BURST_LIMIT", "namespace_id": "2103", "simple": { "limit": 300, "period": 10 } },
    { "name": "API_SOURCE_MINUTE_LIMIT", "namespace_id": "2104", "simple": { "limit": 1800, "period": 60 } },
    { "name": "API_BURST_LIMIT", "namespace_id": "2101", "simple": { "limit": 100, "period": 10 } },
    { "name": "API_MINUTE_LIMIT", "namespace_id": "2102", "simple": { "limit": 600, "period": 60 } },
    { "name": "CLIENT_TELEMETRY_LIMIT", "namespace_id": "2105", "simple": { "limit": 20, "period": 60 } },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Document"] },
    { "tag": "v2", "new_sqlite_classes": ["WorkspaceEvents"] },
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:5173",
  },
  "env": {
    "production": {
      "name": "cloudflare-realtime-notes",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
        "traces": { "enabled": true, "head_sampling_rate": 0.05 },
      },
      "analytics_engine_datasets": [
        { "binding": "OBSERVABILITY", "dataset": "cloudflare_realtime_notes_production" },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudflare-realtime-notes",
          "database_id": "a1e3ebcb-6fb4-4cdb-8ccc-ef5821fb6fbc",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "cloudflare-realtime-notes",
          "preview_bucket_name": "cloudflare-realtime-notes-preview",
        },
      ],
      "browser": { "binding": "BROWSER" },
      "durable_objects": {
        "bindings": [
          { "name": "DOCUMENT", "class_name": "Document" },
          { "name": "WORKSPACE_EVENTS", "class_name": "WorkspaceEvents" },
        ],
      },
      "workflows": [
        {
          "name": "cloudflare-realtime-notes-jobs",
          "binding": "NOTES_WORKFLOW",
          "class_name": "NotesJobWorkflow",
        },
      ],
      "queues": {
        "producers": [{ "binding": "DELIVERY_QUEUE", "queue": "cloudflare-realtime-notes-delivery" }],
        "consumers": [
          {
            "queue": "cloudflare-realtime-notes-delivery",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "cloudflare-realtime-notes-delivery-dlq",
          },
        ],
      },
      "ratelimits": [
        { "name": "API_SOURCE_BURST_LIMIT", "namespace_id": "2103", "simple": { "limit": 300, "period": 10 } },
        { "name": "API_SOURCE_MINUTE_LIMIT", "namespace_id": "2104", "simple": { "limit": 1800, "period": 60 } },
        { "name": "API_BURST_LIMIT", "namespace_id": "2101", "simple": { "limit": 100, "period": 10 } },
        { "name": "API_MINUTE_LIMIT", "namespace_id": "2102", "simple": { "limit": 600, "period": 60 } },
        { "name": "CLIENT_TELEMETRY_LIMIT", "namespace_id": "2105", "simple": { "limit": 20, "period": 60 } },
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://cloudflare-realtime-notes.harold-martin.workers.dev",
      },
    },
    "notes-checks-e2e": {
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "analytics_engine_datasets": [
        { "binding": "OBSERVABILITY", "dataset": "cloudflare_realtime_notes_e2e" },
      ],
      "browser": { "binding": "BROWSER" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudflare-realtime-notes-e2e",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "cloudflare-realtime-notes-e2e",
          "preview_bucket_name": "cloudflare-realtime-notes-e2e",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "DOCUMENT", "class_name": "Document" },
          { "name": "WORKSPACE_EVENTS", "class_name": "WorkspaceEvents" },
        ],
      },
      "workflows": [
        {
          "name": "cloudflare-realtime-notes-jobs-e2e",
          "binding": "NOTES_WORKFLOW",
          "class_name": "NotesJobWorkflow",
        },
      ],
      "queues": {
        "producers": [{ "binding": "DELIVERY_QUEUE", "queue": "cloudflare-realtime-notes-delivery-e2e" }],
        "consumers": [
          {
            "queue": "cloudflare-realtime-notes-delivery-e2e",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "cloudflare-realtime-notes-delivery-dlq-e2e",
          },
        ],
      },
      "ratelimits": [
        { "name": "API_SOURCE_BURST_LIMIT", "namespace_id": "2203", "simple": { "limit": 300, "period": 10 } },
        { "name": "API_SOURCE_MINUTE_LIMIT", "namespace_id": "2204", "simple": { "limit": 1800, "period": 60 } },
        { "name": "API_BURST_LIMIT", "namespace_id": "2101", "simple": { "limit": 100, "period": 10 } },
        { "name": "API_MINUTE_LIMIT", "namespace_id": "2102", "simple": { "limit": 600, "period": 60 } },
        { "name": "CLIENT_TELEMETRY_LIMIT", "namespace_id": "2205", "simple": { "limit": 20, "period": 60 } },
      ],
      "vars": {
        "BETTER_AUTH_URL": "http://127.0.0.1:4173",
        "WORKFLOW_INLINE": "true",
      },
    },
  },
}
