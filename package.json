{
  "name": "noteflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm build:plugin-ui && vite",
    "dev:e2e": "pnpm build:plugin-ui && node scripts/e2e-server.mjs",
    "build": "pnpm build:plugin-ui && pnpm typecheck && vite build && node scripts/build-offline-worker.mjs",
    "build:worker": "wrangler deploy --env production --dry-run --outdir .wrangler/dry-run",
    "preview": "vite preview",
    "test": "pnpm test:unit && pnpm test:worker",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:worker": "pnpm build:plugin-ui && vitest run --config vitest.worker.config.ts",
    "test:worker:coverage": "pnpm build:plugin-ui && vitest run --config vitest.worker.config.ts --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:diagnostics": "playwright test --config tests/diagnostics/playwright.config.mjs",
    "test:e2e:mobile-sidebar": "playwright test --project=mobile-chromium --grep @mobile-sidebar",
    "test:e2e:nightly": "playwright test",
    "test:watch": "pnpm build:plugin-ui && vitest",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "oxlint --fix .",
    "check:middleware": "semgrep scan --strict --no-git-ignore --error --config .semgrep/middleware.yml --exclude='**/*.test.ts' --exclude='**/*.integration.test.ts' src/worker && semgrep test --strict --config .semgrep/middleware.yml .semgrep/middleware.test.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm typecheck:client && pnpm typecheck:worker && pnpm typecheck:unit && pnpm typecheck:worker-tests && pnpm typecheck:config",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "typecheck:unit": "tsc -p tsconfig.unit-test.json",
    "typecheck:worker-tests": "tsc -p tsconfig.worker-test.json",
    "typecheck:config": "tsc -p tsconfig.config.json",
    "analyze": "fallow dead-code --type-aware --fail-on-issues",
    "analyze:audit": "fallow audit --type-aware --brief --format compact",
    "load:realtime": "node scripts/realtime-load.mjs",
    "import:notion": "node scripts/notion-import.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --include-runtime false --env-file worker-typegen.env",
    "cf-typegen:check": "node scripts/check-worker-types.mjs",
    "db:local": "node scripts/migrate-d1.mjs --local",
    "db:remote": "node scripts/migrate-d1.mjs --env production --remote",
    "db:export": "node scripts/d1-export.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm check:middleware && pnpm typecheck && pnpm test:coverage && pnpm test:worker:coverage && pnpm analyze && pnpm cf-typegen:check && pnpm build && pnpm build:worker",
    "deploy": "pnpm build && pnpm db:remote && wrangler deploy --env production",
    "security:reset": "node scripts/security-reset.mjs",
    "observability:report": "node scripts/observability.mjs report",
    "observability:check": "node scripts/observability.mjs check",
    "build:plugin-ui": "node scripts/build-plugin-ui.mjs",
    "plugin:link": "node scripts/link-plugin.mjs",
    "plugin:eval": "node scripts/evaluate-plugin.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@blocknote/core": "0.55.0",
    "@blocknote/mantine": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@xyflow/react": "12.12.0",
    "better-auth": "1.7.7",
    "docx": "9.9.0",
    "fractional-indexing-jittered": "1.1.0",
    "hono": "4.13.13",
    "htmlparser2": "12.0.0",
    "katex": "0.19.0",
    "mammoth": "1.13.0",
    "marked": "18.1.0",
    "mermaid": "12.1.0",
    "partyserver": "0.5.10",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-qr-code": "2.2.0",
    "shiki": "4.5.0",
    "y-indexeddb": "9.0.12",
    "y-partyserver": "2.2.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261007.1",
    "@notionhq/client": "5.27.0",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/katex": "0.16.8",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-istanbul": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "fallow": "3.32.0",
    "jsdom": "30.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "4.148.0",
    "ws": "8.22.0"
  }
}
