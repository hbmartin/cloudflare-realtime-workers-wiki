{
  "name": "cloudflare-realtime-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:e2e": "node scripts/e2e-server.mjs",
    "build": "pnpm typecheck && vite build",
    "build:worker": "wrangler deploy --env production --dry-run --outdir .wrangler/dry-run",
    "preview": "vite preview",
    "test": "pnpm test:unit && pnpm test:worker",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:worker:coverage": "vitest run --config vitest.worker.config.ts --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:mobile-sidebar": "playwright test --project=mobile-chromium --grep @mobile-sidebar",
    "test:e2e:nightly": "playwright test",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm typecheck:client && pnpm typecheck:worker && pnpm typecheck:unit && pnpm typecheck:worker-tests && pnpm typecheck:config",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "typecheck:unit": "tsc -p tsconfig.unit-test.json",
    "typecheck:worker-tests": "tsc -p tsconfig.worker-test.json",
    "typecheck:config": "tsc -p tsconfig.config.json",
    "analyze": "fallow dead-code --type-aware --fail-on-issues",
    "analyze:audit": "fallow audit --type-aware --brief --format compact",
    "load:realtime": "node scripts/realtime-load.mjs",
    "import:notion": "node scripts/notion-import.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --include-runtime false --env-file worker-typegen.env",
    "cf-typegen:check": "node scripts/check-worker-types.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --env production --remote",
    "db:export": "node scripts/d1-export.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:worker:coverage && pnpm analyze && pnpm cf-typegen:check && pnpm build && pnpm build:worker",
    "deploy": "pnpm build && wrangler deploy --env production"
  },
  "dependencies": {
    "@blocknote/core": "0.54.0",
    "@blocknote/mantine": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "better-auth": "1.7.1",
    "fractional-indexing-jittered": "1.0.0",
    "hono": "4.13.3",
    "partyserver": "0.5.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "y-indexeddb": "9.0.12",
    "y-partyserver": "2.2.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260821.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "fallow": "3.17.0",
    "jsdom": "30.0.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0",
    "ws": "8.21.3"
  }
}
